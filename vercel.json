{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Rien à installer : dist/ est généré par py -m app.export dans la GitHub Action\"",
  "buildCommand": "echo \"dist/ déjà généré par py -m app.export\"",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": false },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=300, must-revalidate" }]
    },
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }]
    },
    {
      "source": "/anim.js",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }]
    },
    {
      "source": "/logos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=604800" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(apple-touch-icon|icon-192|icon-512|icon-maskable-512).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
